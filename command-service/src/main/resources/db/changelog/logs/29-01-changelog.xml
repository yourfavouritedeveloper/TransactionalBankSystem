<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1777422871781-1" author="HP">
        <createTable tableName="transactions">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_transactions"/>
            </column>
            <column name="from_account_id" type="UUID"/>
            <column name="to_account_id" type="UUID"/>
            <column name="amount" type="DECIMAL"/>
            <column name="type" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(255)"/>
            <column name="direction" type="VARCHAR(255)"/>
            <column name="currency" type="VARCHAR(255)"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
    </changeSet>
    <changeSet id="1777422871781-2" author="HP">
        <addColumn tableName="accounts">
            <column name="currency" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>
    <changeSet id="1777422871781-3" author="HP">
        <addForeignKeyConstraint baseColumnNames="from_account_id" baseTableName="transactions"
                                 constraintName="FK_TRANSACTIONS_ON_FROM_ACCOUNT" referencedColumnNames="id"
                                 referencedTableName="accounts"/>
    </changeSet>
    <changeSet id="1777422871781-4" author="HP">
        <addForeignKeyConstraint baseColumnNames="to_account_id" baseTableName="transactions"
                                 constraintName="FK_TRANSACTIONS_ON_TO_ACCOUNT" referencedColumnNames="id"
                                 referencedTableName="accounts"/>
    </changeSet>

</databaseChangeLog>